name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Find project (uses the newest .zip in the repo if app/ folder is missing)
        run: |
          set -e
          if [ -f app/build.gradle ] && [ -f settings.gradle ]; then
            echo "Project found at repo root"
            echo "PROJECT_DIR=." >> "$GITHUB_ENV"
          else
            zip=$(for f in *.zip; do [ -f "$f" ] && echo "$(git log -1 --format=%ct -- "$f") $f"; done | sort -rn | head -n1 | cut -d' ' -f2-)
            if [ -z "$zip" ]; then
              echo "::error::app/build.gradle not found and there is no .zip file in the repo root. Upload the project zip file to the repo root."
              exit 1
            fi
            echo "Using zip: $zip"
            rm -rf _proj && mkdir _proj
            unzip -q "$zip" -d _proj
            found=$(find _proj -name settings.gradle | head -n1)
            if [ -z "$found" ]; then
              echo "::error::settings.gradle not found inside $zip"
              exit 1
            fi
            dir=$(dirname "$found")
            if [ ! -f "$dir/app/build.gradle" ]; then
              echo "::error::app/build.gradle not found inside $zip"
              exit 1
            fi
            echo "PROJECT_DIR=$dir" >> "$GITHUB_ENV"
          fi

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Accept Android SDK licenses
        run: yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true

      - name: Build APK
        run: |
          set +e
          cd "$PROJECT_DIR"
          for i in 1 2 3; do
            echo "=== Build attempt $i ==="
            gradle assembleDebug --no-daemon --stacktrace 2>&1 | tee "$GITHUB_WORKSPACE/build.log"
            code=${PIPESTATUS[0]}
            if [ "$code" -eq 0 ]; then exit 0; fi
            if ! grep -qiE "Could not resolve|Could not GET|Could not HEAD|timed out|Connection reset|Connection refused|Received status code 5" "$GITHUB_WORKSPACE/build.log"; then break; fi
            echo "Network problem, retrying in 15s..."
            sleep 15
          done
          {
            echo "## Build failed - main errors"
            echo '```'
            grep -E -A4 "error:|What went wrong|Execution failed|Could not|Caused by" "$GITHUB_WORKSPACE/build.log" | head -80
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
          first=$(grep -m1 -E -A1 "error:|What went wrong" "$GITHUB_WORKSPACE/build.log" | tr '\n' ' ' | cut -c1-300)
          echo "::error::${first}"
          exit 1

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DynamicPill-apk
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
